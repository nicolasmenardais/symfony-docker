<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Stwitcho{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <!-- Bootstrap (CDN jsDelivr) -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <!-- Icônes + police -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
            <!-- Ma feuille de style, juste après Bootstrap -->
            <link href="{{ asset('styles/style.css') }}" rel="stylesheet">
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
    <div class="container site">

        {# ===== ENTÊTE ===== #}
        <header class="page-header">
            <div class="row">
                <div class="col-sm-8">
                    <div class="row">  <h1 class="logo-titre"><span class="rouge">S</span>tw<span class="rouge">I</span>tch<span class="rouge">O</span></h1>  </div>
                    <div class="row">  <h4 class="sous-titre">La plateforme de diffusion vidéo du BTS SIO</h4>  </div>
                </div>
                <div class="col-sm-4">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Stwitcho" class="logo-img">
                </div>
            </div>
        </header>

        {# ===== NAVIGATION ===== #}
        <div class="row">
            <div class="col-sm-12">
                <div class="container ">
                    <div class="navbar navbar-expand-lg bg-dark border-bottom border-body" data-bs-theme="dark">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_home') }}"><i class="bi bi-house-door-fill"></i> Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_videos') }}"><i class="bi bi-camera-reels-fill"></i> Vidéos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_membres') }}"><i class="bi bi-people-fill"></i> Membres</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_categories') }}"><i class="bi bi-tags-fill"></i> Catégories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#about"><i class="bi bi-envelope-fill"></i> Contact</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# ===== SÉPARATION ===== #}
        <div class="row">
            <div class="col-sm-12">        <hr/>    </div>
        </div>

        {# ===== PANEL (titre spécifique) ===== #}
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        {% block paneltitle %} {% endblock %}
                    </div>
                </div>
            </div>
        </div>

        {# ===== CONTENU ===== #}
        <div class="row">
            <div class="col-sm-12">
                {% block body %} {% endblock %}
            </div>
        </div>

        {# ===== PIED DE PAGE ===== #}
        <div class="nav navbar-fixed-bottom" id="about">
            <div class="container">
                <div>
                    <p>nicolas </p>
                </div>
            </div>
        </div>

    </div>
    </body>
</html>