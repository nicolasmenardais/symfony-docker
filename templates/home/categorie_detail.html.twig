{% extends 'base.html.twig' %}

{% block title %}
    Catégorie "{{ categorie.libelle }}"
{% endblock %}

{% block paneltitle %} <h1><i class="bi bi-bookmark-star-fill"></i> Catégorie : {{ categorie.libelle }}</h1> {% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-6">
            <table class="table table-striped table-hover">
                <thead>
                    <tr><th>Vidéos de la catégorie</th></tr>
                </thead>
                <tbody>
                {% for v in categorie.videos %}
                    <tr><td><a href="{{ path('app_video_detail', {id: v.id}) }}"><i class="bi bi-play-fill"></i> {{ v.titre }}</a></td></tr>
                {% else %}
                    <tr><td>Aucune vidéo dans cette catégorie.</td></tr>
                {% endfor %}
                </tbody>
            </table>
            <a class="btn btn-neon" href="{{ path('app_categories') }}"><i class="bi bi-arrow-left"></i> Toutes les catégories</a>
        </div>
    </div>
{% endblock %}