{% extends 'base.html.twig' %}

{% block title %}
    Membres
{% endblock %}

{% block paneltitle %} <h1><i class="bi bi-people-fill"></i> Les Membres</h1> {% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-6">
            <table class="table table-striped table-hover">
                <thead>
                    <tr><th>Pseudo</th><th>Vidéos déposées</th></tr>
                </thead>
                <tbody>
                {% for m in les_membres %}
                    <tr>
                        <td><a href="{{ path('app_membres_detail', {'id': m.id}) }}"><i class="bi bi-person-circle"></i> {{ m.Pseudo }}</a></td>
                        <td><span class="badge-neon">{{ m.videos|length }}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="2">Aucun membre.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}