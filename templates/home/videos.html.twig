{% extends 'base.html.twig' %}

{% block title %}
    Vidéos
{% endblock %}

{% block paneltitle %} <h1><i class="bi bi-camera-reels-fill"></i> Les Vidéos</h1> {% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-sm-6">
            <table class="table table-striped table-hover">
                <thead>
                    <tr><th>Titre</th><th>Durée</th><th>Vues</th></tr>
                </thead>
                <tbody>
                {% for v in les_videos %}
                    <tr>
                        <td><a href="{{ path('app_video_detail', {'id': v.id}) }}"><i class="bi bi-play-fill"></i> {{ v.titre }}</a></td>
                        <td>{{ v.duree }}</td>
                        <td>{{ v.nbVues|default(0) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Aucune vidéo pour le moment.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="col-sm-6">
            <div class="carte text-center">
                <i class="bi bi-collection-play-fill icone"></i>
                <div class="chiffre">{{ les_videos|length }}</div>
                <p>vidéo(s) disponible(s)</p>
                <a class="btn btn-neon" href="{{ path('app_categories') }}"><i class="bi bi-tags-fill"></i> Voir par catégorie</a>
            </div>
        </div>
    </div>
{% endblock %}