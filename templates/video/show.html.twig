{% extends 'base.html.twig' %}

{% block title %}Video{% endblock %}

{% block body %}
    <h1>Video</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ video.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ video.titre }}</td>
            </tr>
            <tr>
                <th>Duree</th>
                <td>{{ video.duree }}</td>
            </tr>
            <tr>
                <th>Taille</th>
                <td>{{ video.taille }}</td>
            </tr>
            <tr>
                <th>Nb_vues</th>
                <td>{{ video.nbVues }}</td>
            </tr>
            <tr>
                <th>Nb_like</th>
                <td>{{ video.nbLike }}</td>
            </tr>
            <tr>
                <th>Live</th>
                <td>{{ video.live ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_video_index') }}">back to list</a>

    <a href="{{ path('app_video_edit', {'id': video.id}) }}">edit</a>

    {{ include('video/_delete_form.html.twig') }}
{% endblock %}
